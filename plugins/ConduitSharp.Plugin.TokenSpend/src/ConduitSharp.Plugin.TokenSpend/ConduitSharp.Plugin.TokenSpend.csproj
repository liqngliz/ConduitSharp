<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <RootNamespace>ConduitSharp.Plugin.TokenSpend</RootNamespace>
    <IsPackable>false</IsPackable>
    <!--
      Records what every LLM call actually cost in tokens, as durable history. Reads the same
      provider `usage` fields as token-rate-limit, but persists a row per request instead of
      charging a window. Variant "token-spend".

      References ConduitSharp.Core and nothing else: the store is this plugin's own ISpendStore,
      so nothing here reaches into Traffic the way token-rate-limit does for IRateLimitStore.
    -->
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\ConduitSharp.Core\ConduitSharp.Core.csproj" />
  </ItemGroup>
</Project>
