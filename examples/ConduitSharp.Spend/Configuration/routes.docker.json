{
  "routes": [
    {
      "id": "claude",
      "description": "claude through the spend meter",
      "route": {
        "match": {
          "path": "/llm/claude/{**rest}"
        },
        "transforms": [
          {
            "PathRemovePrefix": "/llm/claude"
          }
        ]
      },
      "cluster": {
        "destinations": {
          "node-0": {
            "address": "https://api.anthropic.com"
          }
        }
      },
      "plugins": [
        {
          "name": "custom",
          "variant": "token-spend",
          "order": 4,
          "enabled": true,
          "config": {
            "inputFields": [
              "usage.prompt_tokens",
              "usage.input_tokens",
              "-usage.input_tokens_details.cached_tokens",
              "prompt_eval_count"
            ],
            "outputFields": [
              "usage.completion_tokens",
              "usage.output_tokens",
              "eval_count"
            ],
            "cacheWriteFields": [
              "usage.cache_creation_input_tokens",
              "usage.input_tokens_details.cache_write_tokens"
            ],
            "cacheReadFields": [
              "usage.cache_read_input_tokens",
              "usage.input_tokens_details.cached_tokens"
            ],
            "maxResponseBytes": 4194304,
            "maxRequestBytes": 4194304,
            "capturePrompts": true,
            "maxPromptChars": 200,
            "keyHeader": "x-api-key"
          }
        },
        {
          "name": "custom",
          "variant": "body-capture-file",
          "order": 5,
          "enabled": true,
          "config": {
            "request": {
              "maxSize": 262144
            },
            "response": {
              "maxSize": 262144
            },
            "logPath": "/data/conduit-wire.jsonl",
            "maxFileBytes": 134217728
          }
        },
        {
          "name": "http-proxy",
          "order": 99,
          "enabled": true
        }
      ]
    },
    {
